    "parameters": [
      {
        "name": "castle_width",
        "type": "float",
        "value": 24.0,
        "min": 12.0,
        "max": 80.0,
        "description": "outer size of the square curtain wall",
        "unit": "m"
      },
      {
        "name": "wall_height",
        "type": "float",
        "value": 6.0,
        "min": 3.0,
        "max": 20.0,
        "unit": "m"
      },
      {
        "name": "wall_thickness",
        "type": "float",
        "value": 1.2,
        "min": 0.5,
        "max": 3.0,
        "unit": "m"
      },
      {
        "name": "tower_count",
        "type": "int",
        "value": 6,
        "min": 4,
        "max": 16,
        "description": "towers on the side walls (even)"
      },
      {
        "name": "tower_radius",
        "type": "float",
        "value": 2.2,
        "min": 1.0,
        "max": 6.0,
        "unit": "m"
      },
      {
        "name": "gate_width",
        "type": "float",
        "value": 3.0,
        "min": 1.0,
        "max": 10.0,
        "unit": "m"
      },
      {
        "name": "gate_height",
        "type": "float",
        "value": 4.0,
        "min": 1.5,
        "max": 16.0,
        "unit": "m"
      },
      {
        "name": "detail_density",
        "type": "int",
        "value": 2,
        "min": 0,
        "max": 3,
        "description": "battlements, windows, segments"
      },
      {
        "name": "towers_per_side",
        "type": "int",
        "value": {
          "expr": "tower_count // 2"
        },
        "min": 2
      },
      {
        "name": "tower_height",
        "type": "float",
        "value": {
          "expr": "wall_height * 1.4"
        },
        "min": 1
      },
      {
        "name": "merlons_per_wall",
        "type": "int",
        "value": {
          "expr": "max(3, floor(castle_width * (detail_density + 1) / 6))"
        },
        "min": 3
      }
    ],
    "rules": [
      {
        "name": "even_towers",
        "expr": "tower_count % 2 == 0",
        "message": "tower_count must be even (two rows of towers)"
      },
      {
        "name": "towers_fit",
        "expr": "2 * tower_radius + 1 <= castle_width / (tower_count / 2 - 1)",
        "message": "towers would overlap: reduce tower_radius or tower_count, or widen the castle"
      },
      {
        "name": "gate_fits_width",
        "expr": "gate_width + 2 * tower_radius + 2 <= castle_width",
        "message": "the gate is too wide for the front wall"
      },
      {
        "name": "gate_fits_height",
        "expr": "gate_height + 1 <= wall_height",
        "message": "the gate must be lower than the wall"
      },
      {
        "name": "arch_fits",
        "expr": "gate_width / 2 < gate_height",
        "message": "the gate arch is taller than the gate"
      }
    ],
