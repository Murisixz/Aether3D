# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Scratch project files (the committed example under examples/ is kept)
*.aether
!examples/*.aether
!tests/data/**/*.aether

# Example and tool output
gltf_roundtrip_output/
tools/gltf-validator/node_modules/
minecraft_hero_output/
examples/output/mcp_workspace/
examples/output/mcp_castle_workspace/
examples/output/mcp_feedback_workspace/
examples/output/mcp_sculpt_workspace/
examples/output/mcp_texture_workspace/
examples/output/mcp_cad_workspace/
# Animation showcases: frame sequences are regenerated by the scripts, never committed;
# their curated scenes (.aether) are kept
examples/output/animation/*/frames/
!examples/output/animation/**/*.aether
examples/output/animation/large/large.aether
# World showcases: frame sequences, full-resolution stills, lossless masters and 1080p
# encodes are regenerated by the scripts and stay out of Git (each report.json records their
# paths, sizes and PSNR/SSIM checks); previews, contact sheets, the memory chart, preview
# videos, reports and scenes are kept
examples/output/worlds/*/frames/
examples/output/worlds/*/*_master.mkv
examples/output/worlds/*/*_1080p.mp4
examples/output/worlds/*/*.png
!examples/output/worlds/*/*_preview.png
!examples/output/worlds/*/*_sheet.png
!examples/output/worlds/c_streaming/memory.png
!examples/output/worlds/**/*.aether

# The native crate (native/): build products
native/target/
# Rigging showcases (0.19.0): frame sequences, close-up tiles, full-resolution stills,
# lossless masters, 1080p encodes, the skinned characters' scenes and GLBs (5-20 MB each)
# are regenerated by the scripts and stay out of Git (each report.json records their
# paths, sizes, render times and PSNR/SSIM checks); previews, sheets, diagnostic images,
# preview videos, reports and the rigid-part character's scene are kept
examples/output/rigging/*/frames/
examples/output/rigging/*/tiles/
examples/output/rigging/*/keys/
examples/output/rigging/*/*_master.mkv
examples/output/rigging/*/*_1080p.mp4
examples/output/rigging/*/*.glb
examples/output/rigging/*/hero_*.png
!examples/output/rigging/*/hero_*_preview.png
!examples/output/rigging/e_rigid/kit.aether
# ... except one 1080p encode (0.19.1): the revised auto-rigged figure's showcase video
!examples/output/rigging/a_autorig/autorig_1080p.mp4
# Film showcases (0.20.0): frame sequences, full-resolution stills, lossless masters and
# 1080p encodes are regenerated by the scripts and stay out of Git (each report.json records
# their paths, sizes, render times and PSNR/SSIM checks); previews, sheets, graphs, proofs,
# preview videos and reports are kept
examples/output/film/*/frames/
examples/output/film/*/*_master.mkv
examples/output/film/*/*_1080p.mp4
examples/output/film/*/hero.png
examples/output/film/b_character/closeup.png
examples/output/film/e_studio/presets/
examples/output/film/i_mcp_agent/workspace/
