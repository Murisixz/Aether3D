        "back": {"mesh": "@block", "material": "@stone", "position": [-4.5, 4.5, 0.5], "grid": {"count": [10, 1, 14]}},
        "left": {"mesh": "@block", "material": "@stone", "position": [-4.5, -3.5, 0.5], "grid": {"count": [1, 8, 14]}},
        "right": {"mesh": "@block", "material": "@stone", "position": [4.5, -3.5, 0.5], "grid": {"count": [1, 8, 14]}},
        "roof": {"mesh": "@keep_roof", "material": "@roof", "position": [0, 0, 16.5], "rotation_euler": [0, 0, 45]},
        "door": {"mesh": {"primitive": "box", "size": [2, 0.2, 3]}, "material": "@wood", "position": [0, -4.9, 1.5]}
      }
