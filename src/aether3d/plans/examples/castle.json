    "drawbridge": {"mesh": {"primitive": "box", "size": [4, 8, 0.3]}, "material": "@wood", "position": [0, -22, 0.2], "tags": ["gate"]},
    "trees": {
      "parent": "@castle", "prefab": "@tree", "name": "Tree {i}",
      "instances": [
        {"position": [-10, -10, 0]}, {"position": [-8, -4, 0]}, {"position": [-11, 3, 0]},
        {"position": [10, -10, 0]}, {"position": [9, -3, 0]}, {"position": [11, 4, 0]},
        {"position": [-6, 12, 0]}, {"position": [7, 12, 0]}
      ]
