    "torches": {
      "light": {"type": "point", "color": "#ffb060", "intensity": 3, "range": 14},
      "instances": [{"position": [-2.6, -16.6, 3.6]}, {"position": [2.6, -16.6, 3.6]}, {"position": [0, -1.2, 3.8]}]
    },
    "sun": {"light": {"type": "directional", "intensity": 2.2, "angle": 1.5}, "direction": [-0.45, 0.55, -0.7]},
    "camera": {"camera": {"fov": 42}, "position": [46, -58, 34], "look_at": [0, 0, 5], "active": true}
  },
  "world": {"background": "#9fc8ec", "ambient_intensity": 0.25},
  "queries": [
    {"query": "overlaps", "objects": "@trees/leaves", "against": ["@keep/front", "@keep/back", "@keep/left", "@keep/right"]},
    {"query": "raycast", "origin": [0, -30, 20], "direction": [0, 0.6, -0.4]}
  ]
