    "wall_south_right": {"parent": "@castle", "mesh": "@block", "material": "@stone", "tags": ["wall"],
                         "position": [2.5, -15.5, 0.5], "grid": {"count": [10, 1, 6]}},
    "gate_lintel": {"parent": "@castle", "mesh": "@block", "material": "@dark_stone", "tags": ["wall", "gate"],
                    "position": [-1.5, -15.5, 4.5], "grid": {"count": [4, 1, 2]}},
    "battlements": {
      "parent": "@castle", "mesh": "@block", "material": "@dark_stone", "tags": ["battlement"],
      "instances": {"positions": [
        [-11.5, 15.5, 6.5], [-9.5, 15.5, 6.5], [-7.5, 15.5, 6.5], [-5.5, 15.5, 6.5], [-3.5, 15.5, 6.5], [-1.5, 15.5, 6.5],
        [0.5, 15.5, 6.5], [2.5, 15.5, 6.5], [4.5, 15.5, 6.5], [6.5, 15.5, 6.5], [8.5, 15.5, 6.5], [10.5, 15.5, 6.5],
        [-11.5, -15.5, 6.5], [-9.5, -15.5, 6.5], [-7.5, -15.5, 6.5], [-5.5, -15.5, 6.5], [-3.5, -15.5, 6.5], [-1.5, -15.5, 6.5],
        [0.5, -15.5, 6.5], [2.5, -15.5, 6.5], [4.5, -15.5, 6.5], [6.5, -15.5, 6.5], [8.5, -15.5, 6.5], [10.5, -15.5, 6.5],
        [15.5, -11.5, 6.5], [15.5, -9.5, 6.5], [15.5, -7.5, 6.5], [15.5, -5.5, 6.5], [15.5, -3.5, 6.5], [15.5, -1.5, 6.5],
        [15.5, 0.5, 6.5], [15.5, 2.5, 6.5], [15.5, 4.5, 6.5], [15.5, 6.5, 6.5], [15.5, 8.5, 6.5], [15.5, 10.5, 6.5],
        [-15.5, -11.5, 6.5], [-15.5, -9.5, 6.5], [-15.5, -7.5, 6.5], [-15.5, -5.5, 6.5], [-15.5, -3.5, 6.5], [-15.5, -1.5, 6.5],
        [-15.5, 0.5, 6.5], [-15.5, 2.5, 6.5], [-15.5, 4.5, 6.5], [-15.5, 6.5, 6.5], [-15.5, 8.5, 6.5], [-15.5, 10.5, 6.5]
      ]}
    },
    "towers": {
      "parent": "@castle", "prefab": "@tower", "name": "Tower {i}",
      "instances": [
        {"position": [-15, -15, 0], "name": "Tower SW"},
        {"position": [15, -15, 0], "name": "Tower SE"},
        {"position": [15, 15, 0], "rotation_euler": [0, 0, 180], "name": "Tower NE"},
        {"position": [-15, 15, 0], "rotation_euler": [0, 0, 180], "name": "Tower NW"}
      ]
    },
    "keep": {
      "parent": "@castle", "position": [0, 4, 0], "tags": ["keep"],
      "children": {
        "front": {"mesh": "@block", "material": "@stone", "position": [-4.5, -4.5, 0.5], "grid": {"count": [10, 1, 14]},
